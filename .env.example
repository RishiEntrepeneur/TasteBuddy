# ---------------------------------------------------------------------------
# TasteBuddy environment
#
# Every value here is optional. With none of them set the app runs entirely on
# the seed dataset and the mock mesh generator, which is what `npm run dev`
# expects — no database, no API keys, no asset bucket.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# When set, the app reads restaurants, menus and 3D assets from Postgres
# instead of lib/db/seed.ts. Apply db/schema.sql first.
# DATABASE_URL=postgres://user:password@host:5432/tastebuddy

# Set to `disable` only for a local Postgres with no TLS.
# PGSSLMODE=disable

# Connections per serverless container. Keep this small.
# PGPOOL_MAX=5

# --- Asset CDN -------------------------------------------------------------
# Base URL that generated .glb files are served from. Defaults to /assets,
# which serves them from public/ for local development.
# ASSET_CDN_URL=https://cdn.tastebuddy.app
# NEXT_PUBLIC_ASSET_CDN_URL=https://cdn.tastebuddy.app

# --- 2D-to-3D generator ----------------------------------------------------
# Leave unset to use the built-in mock generator, which follows the same
# contract (job id now, signed callback later) without calling a paid API.
# GENERATOR_WEBHOOK_URL=https://api.example-mesh-service.com/v1/jobs
# GENERATOR_API_KEY=

# HMAC-SHA256 secret used to sign and verify generator callbacks.
# Required in production — the dev default is not a secret.
# GENERATOR_WEBHOOK_SECRET=

# --- Restaurant staff access -----------------------------------------------
# HMAC secret signing the menu-editor session cookie. REQUIRED in production:
# the app refuses to issue staff sessions without it, because a known secret
# lets anyone mint a session for any venue. 32+ random characters.
# STAFF_SESSION_SECRET=

# Venues sign in with an access key. Only its SHA-256 is stored, so issue one
# and give the venue the plaintext once:
#   KEY=$(openssl rand -hex 32)
#   psql "$DATABASE_URL" -c "INSERT INTO restaurant_staff_keys (restaurant_id, key_hash, label)
#     SELECT id, encode(digest('$KEY','sha256'),'hex'), 'Front of house'
#     FROM restaurants WHERE slug = 'your-venue';"
#   echo "$KEY"
# Without DATABASE_URL the editor accepts 'tastebuddy-dev-staff-key' for the
# seed venue — a demo affordance that has no effect once a database is set.

# --- Menu photo import -----------------------------------------------------
# Reading a photographed menu uses Claude's vision model. Leave unset and the
# editor simply does not offer the "Import from a photo" button — every other
# part of the editor works without it.
#
# Get a key at https://console.anthropic.com → Settings → API keys. Billing has
# to be set up on the account first; a menu photo costs a fraction of a penny
# to read, and the per-venue hourly cap in db/schema.sql keeps a runaway loop
# from turning that into a real bill.
#
# The model transcribes names, descriptions and prices. It is never asked what
# a dish contains: imported dishes are saved switched off, with no allergens,
# until a person declares them.
# ANTHROPIC_API_KEY=sk-ant-...

# --- App -------------------------------------------------------------------
# Absolute origin used to build the generator's callback URL. Falls back to
# the incoming request's origin.
# NEXT_PUBLIC_APP_URL=https://tastebuddy.app
