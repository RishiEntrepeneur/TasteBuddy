{
  "name": "tastebuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Point your phone at a menu you cannot read and it tells you what every dish is.",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:lan:https": "next dev -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:tracker": "tsx scripts/verify-plate-tracker.ts",
    "verify:contrast": "tsx scripts/verify-brand-contrast.ts",
    "try:menu": "tsx scripts/try-menu.ts",
    "verify:shapes": "tsx scripts/verify-dish-shapes.ts",
    "demo:build": "next build && node demo/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
